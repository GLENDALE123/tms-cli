{
  "name": "@hs-jig/tms-cli",
  "version": "0.2.2",
  "description": "Read-only Firebase CLI for TMS",
  "type": "module",
  "bin": {
    "tms": "bin/tms.js"
  },
  "files": [
    "bin",
    "src/browser.js",
    "src/agent.js",
    "src/connect-retry.js",
    "src/tls-connect.js",
    "src/transport.js",
    "src/config.js",
    "src/credentials.js",
    "src/criteria.js",
    "src/http.js",
    "src/login.js",
    "src/notice.js",
    "src/retrieval.js",
    "src/session.js",
    "src/state.js",
    "README.md",
    "AGENT_GUIDE.md",
    "src/update.js"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "undici": "7.29.0"
  },
  "scripts": {
    "postinstall": "node ./bin/install-notice.js",
    "test": "node --test --test-concurrency=1",
    "prepublishOnly": "npm test"
  }
}
